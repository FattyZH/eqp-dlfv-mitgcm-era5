#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
info() { printf '[INFO] %s\n' "$*"; }
die() { printf '[ERROR] %s\n' "$*" >&2; exit 1; }
trap 'printf "[ERROR] mitrun failed near line %s\n" "$LINENO" >&2' ERR

usage() {
    cat <<'EOF'
Usage: mitrun [experiment_dir] [options]

Build:
  -rootdir PATH       MITgcm root (or set MITgcm_HOME)
  -mods PATH          Code directory (default: code)
  -of FILE            genmake2 options file (default: linux_amd64_gfortran)
  -mpi N              Build with MPI and run N tasks
  -omp N              Build with OpenMP and use N threads per task
  -ob, --only-build   Build mitgcmuv and exit without submitting a job
  -nb, --no-build     Reuse build/mitgcmuv without rebuilding
  -genmake-arg ARG    Extra genmake2 argument (repeatable)

Run:
  -pickup PATH        Pickup source (default: pickup); time comes from input/data
  -output PATH        Output root (default: output)

Slurm:
  -name NAME           Job name and run-directory suffix
  -partition NAME     Partition
  -time LIMIT         Wall time (default: 7-00:00:00)
  -nodes N            Nodes
  -ntasks-per-node N  Tasks per node
  -account NAME       Account
  -qos NAME           QoS
  -constraint EXPR    Node constraint
  -sbatch-arg ARG     Extra sbatch argument (repeatable)
  -h, --help          Show help

The default is sbatch submission. MPI jobs are launched with mpirun.
Query status/timing with:
  sacct -j JOB_ID --format=JobID,State,Elapsed,ExitCode
EOF
}

need_value() { (( $# >= 2 )) && [[ -n ${2:-} ]] || die "$1 requires a value"; }
positive_integer() { [[ $1 =~ ^[1-9][0-9]*$ ]]; }
resolve_from() {
    if [[ $2 = /* ]]; then realpath -- "$2"; else realpath -- "$1/$2"; fi
}

EXP_DIR="$(cd -- "$SCRIPT_DIR/.." && pwd)"
ROOTDIR=${MITgcm_HOME:-}
MODS_DIR=code
OUTPUT_DIR=output
BUILD_OPTS_FILE=linux_amd64_gfortran
PICKUP_DIR=pickup
MPI_PROCS=0
OMP_THREADS=0
SKIP_BUILD=false
ONLY_BUILD=false
GENMAKE_ARGS=()
SBATCH_EXTRA_ARGS=()
SLURM_JOB_NAME=
SLURM_PARTITION=${MITGCM_SLURM_PARTITION:-}
SLURM_TIME=${MITGCM_SLURM_TIME:-7-00:00:00}
SLURM_NODES=${MITGCM_SLURM_NODES:-}
SLURM_NTASKS_PER_NODE=${MITGCM_SLURM_NTASKS_PER_NODE:-}
SLURM_ACCOUNT=${MITGCM_SLURM_ACCOUNT:-}
SLURM_QOS=${MITGCM_SLURM_QOS:-}
SLURM_CONSTRAINT=${MITGCM_SLURM_CONSTRAINT:-}

while (( $# )); do
    case $1 in
        -h|--help) usage; exit 0 ;;
        -rootdir) need_value "$@"; ROOTDIR=$2; shift 2 ;;
        -mods) need_value "$@"; MODS_DIR=$2; shift 2 ;;
        -of) need_value "$@"; BUILD_OPTS_FILE=$2; shift 2 ;;
        -mpi) need_value "$@"; positive_integer "$2" || die "-mpi requires a positive integer"; MPI_PROCS=$2; shift 2 ;;
        -omp) need_value "$@"; positive_integer "$2" || die "-omp requires a positive integer"; OMP_THREADS=$2; shift 2 ;;
        -pickup) need_value "$@"; PICKUP_DIR=$2; shift 2 ;;
        -output) need_value "$@"; OUTPUT_DIR=$2; shift 2 ;;
        -ob|--only-build) ONLY_BUILD=true; shift ;;
        -nb|--no-build) SKIP_BUILD=true; shift ;;
        -genmake-arg) need_value "$@"; GENMAKE_ARGS+=("$2"); shift 2 ;;
        -n|-name) need_value "$@"; [[ $2 =~ ^[A-Za-z0-9._-]+$ ]] || die "-name may contain only letters, numbers, dot, underscore, and hyphen"; SLURM_JOB_NAME=$2; shift 2 ;;
        -partition) need_value "$@"; SLURM_PARTITION=$2; shift 2 ;;
        -time) need_value "$@"; SLURM_TIME=$2; shift 2 ;;
        -nodes) need_value "$@"; positive_integer "$2" || die "-nodes requires a positive integer"; SLURM_NODES=$2; shift 2 ;;
        -ntasks-per-node) need_value "$@"; positive_integer "$2" || die "-ntasks-per-node requires a positive integer"; SLURM_NTASKS_PER_NODE=$2; shift 2 ;;
        -account) need_value "$@"; SLURM_ACCOUNT=$2; shift 2 ;;
        -qos) need_value "$@"; SLURM_QOS=$2; shift 2 ;;
        -constraint) need_value "$@"; SLURM_CONSTRAINT=$2; shift 2 ;;
        -sbatch-arg) need_value "$@"; SBATCH_EXTRA_ARGS+=("$2"); shift 2 ;;
        -*) die "unknown option: $1 (use -genmake-arg or -sbatch-arg for passthrough)" ;;
        *) [[ -d $1 ]] || die "experiment directory not found: $1"; EXP_DIR=$1; shift ;;
    esac
done

[[ $SKIP_BUILD == false || $ONLY_BUILD == false ]] || die "--no-build and --only-build cannot be used together"
[[ -n $ROOTDIR ]] || die "specify -rootdir or set MITgcm_HOME"
ROOTDIR="$(realpath -- "$ROOTDIR")"
EXP_DIR="$(realpath -- "$EXP_DIR")"
MODS_DIR="$(resolve_from "$EXP_DIR" "$MODS_DIR")"
OUTPUT_ROOT="$(resolve_from "$EXP_DIR" "$OUTPUT_DIR")"
[[ -x $ROOTDIR/tools/genmake2 ]] || die "genmake2 not found: $ROOTDIR/tools/genmake2"
[[ -d $MODS_DIR ]] || die "code directory not found: $MODS_DIR"
if [[ $BUILD_OPTS_FILE = /* ]]; then
    BUILD_OPTS_PATH=$BUILD_OPTS_FILE
else
    BUILD_OPTS_PATH="$ROOTDIR/tools/build_options/$BUILD_OPTS_FILE"
fi
[[ -f $BUILD_OPTS_PATH ]] || die "build options not found: $BUILD_OPTS_PATH"

BUILD_DIR="$EXP_DIR/build"
INPUT_DIR="$EXP_DIR/input"
LOG_DIR="$EXP_DIR/log"
BUILD_LOG="$LOG_DIR/build.log"
BUILD_JOBS=${MITGCM_BUILD_JOBS:-$(nproc)}
positive_integer "$BUILD_JOBS" || die "MITGCM_BUILD_JOBS must be a positive integer"
(( BUILD_JOBS > 8 )) && BUILD_JOBS=8
mkdir -p -- "$LOG_DIR" "$OUTPUT_ROOT"
info "MITgcm root: $ROOTDIR"
info "Experiment:  $EXP_DIR"
info "Code mods:   $MODS_DIR"

if [[ $SKIP_BUILD == false ]]; then
    mkdir -p -- "$BUILD_DIR"
    info "Building MITgcm with $BUILD_JOBS parallel jobs (log: $BUILD_LOG)"
    # A clean tree avoids silently reusing objects built with different
    # MPI/OpenMP or compiler options. --no-build is the explicit reuse mode.
    find "$BUILD_DIR" -mindepth 1 -maxdepth 1 -delete
    (
        cd -- "$BUILD_DIR"
        printf '=== Build started at %s ===\n' "$(date --iso-8601=seconds)"
        genmake_cmd=("$ROOTDIR/tools/genmake2" -rootdir "$ROOTDIR" -of "$BUILD_OPTS_PATH" -mods "$MODS_DIR")
        (( MPI_PROCS > 0 )) && genmake_cmd+=(-mpi)
        (( OMP_THREADS > 0 )) && genmake_cmd+=(-omp)
        genmake_cmd+=("${GENMAKE_ARGS[@]}")
        "${genmake_cmd[@]}"
        make depend
        make -j "$BUILD_JOBS"
        printf '=== Build completed at %s ===\n' "$(date --iso-8601=seconds)"
    ) >"$BUILD_LOG" 2>&1
fi

[[ -x $BUILD_DIR/mitgcmuv ]] || die "executable not found: $BUILD_DIR/mitgcmuv (see $BUILD_LOG)"
if [[ $ONLY_BUILD == true ]]; then
    info "Build completed: $BUILD_DIR/mitgcmuv"
    exit 0
fi
if (( MPI_PROCS > 0 )); then
    command -v mpirun >/dev/null 2>&1 || die "mpirun not found; load the MPI environment"
fi
[[ -d $INPUT_DIR ]] || die "input directory not found: $INPUT_DIR"
[[ $PICKUP_DIR = /* ]] || PICKUP_DIR="$EXP_DIR/$PICKUP_DIR"

RUN_PREFIX="$(date +%y%m%d)"
[[ -n $SLURM_JOB_NAME ]] && RUN_PREFIX+="_$SLURM_JOB_NAME"
RUN_DIR="$OUTPUT_ROOT/$RUN_PREFIX"
if ! mkdir -- "$RUN_DIR" 2>/dev/null; then
    [[ -e $RUN_DIR ]] || die "cannot create run directory: $RUN_DIR"
    run_id=1
    while ! mkdir -- "$OUTPUT_ROOT/${RUN_PREFIX}_$run_id" 2>/dev/null; do
        [[ -e $OUTPUT_ROOT/${RUN_PREFIX}_$run_id ]] || die "cannot create run directory: $OUTPUT_ROOT/${RUN_PREFIX}_$run_id"
        (( ++run_id ))
    done
    RUN_DIR="$OUTPUT_ROOT/${RUN_PREFIX}_$run_id"
fi
cp -- "$BUILD_DIR/mitgcmuv" "$RUN_DIR/"
shopt -s nullglob dotglob
for source in "$INPUT_DIR"/*; do
    name=${source##*/}
    if [[ -d $source ]]; then
        ln -s -- "$(realpath -- "$source")" "$RUN_DIR/$name"
    else
        cp -- "$source" "$RUN_DIR/"
    fi
done
shopt -u nullglob dotglob

[[ -f $SCRIPT_DIR/link-pickup ]] || die "pickup helper not found: $SCRIPT_DIR/link-pickup"
"$SCRIPT_DIR/link-pickup" --data "$RUN_DIR/data" --pickup-dir "$PICKUP_DIR" --dest "$RUN_DIR"

JOB_SCRIPT="$RUN_DIR/run_slurm.sh"
{
    printf '#!/usr/bin/env bash\n'
    [[ -n $SLURM_JOB_NAME ]] && printf '#SBATCH --job-name=%s\n' "$SLURM_JOB_NAME"
    printf '#SBATCH --ntasks=%s\n' "$(( MPI_PROCS > 0 ? MPI_PROCS : 1 ))"
    [[ -n $SLURM_PARTITION ]] && printf '#SBATCH --partition=%s\n' "$SLURM_PARTITION"
    [[ -n $SLURM_TIME ]] && printf '#SBATCH --time=%s\n' "$SLURM_TIME"
    [[ -n $SLURM_NODES ]] && printf '#SBATCH --nodes=%s\n' "$SLURM_NODES"
    [[ -n $SLURM_NTASKS_PER_NODE ]] && printf '#SBATCH --ntasks-per-node=%s\n' "$SLURM_NTASKS_PER_NODE"
    [[ -n $SLURM_ACCOUNT ]] && printf '#SBATCH --account=%s\n' "$SLURM_ACCOUNT"
    [[ -n $SLURM_QOS ]] && printf '#SBATCH --qos=%s\n' "$SLURM_QOS"
    [[ -n $SLURM_CONSTRAINT ]] && printf '#SBATCH --constraint=%s\n' "$SLURM_CONSTRAINT"
    (( OMP_THREADS > 0 )) && printf '#SBATCH --cpus-per-task=%s\n' "$OMP_THREADS"
    for sbatch_arg in "${SBATCH_EXTRA_ARGS[@]}"; do
        printf '#SBATCH %s\n' "$sbatch_arg"
    done
    printf '\nset -Eeuo pipefail\n'
    printf 'cd -- %q\n' "$RUN_DIR"
    (( OMP_THREADS > 0 )) && printf 'export OMP_NUM_THREADS=%q\n' "$OMP_THREADS"
    printf 'exec '
    if (( MPI_PROCS > 0 )); then
        printf '%q ' mpirun -np "$MPI_PROCS" ./mitgcmuv
    else
        printf '%q ' ./mitgcmuv
    fi
    printf '\n'
} >"$JOB_SCRIPT"
chmod +x -- "$JOB_SCRIPT"

info "Run directory: $RUN_DIR"
if [[ -n ${SLURM_JOB_ID:-} ]]; then
    info "Starting in Slurm allocation $SLURM_JOB_ID; output: $RUN_DIR/run.log"
    "$JOB_SCRIPT" >"$RUN_DIR/run.log" 2>&1
else
    command -v sbatch >/dev/null 2>&1 || die "sbatch not found; load the Slurm environment"
    JOB_ID="$(
        cd -- "$RUN_DIR"
        sbatch --parsable "$JOB_SCRIPT"
    )"
    JOB_ID=${JOB_ID%%;*}
    info "Submitted Slurm job: $JOB_ID"
    info "Monitor: squeue -j $JOB_ID"
    info "Details: sacct -j $JOB_ID --format=JobID,State,Elapsed,ExitCode"
    info "Cancel:  scancel $JOB_ID"
fi
